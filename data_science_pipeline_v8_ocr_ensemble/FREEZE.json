{
  "schema": "data-science-pipeline/ocr-ensemble-fresh-freeze/2",
  "source_discovery": {
    "official_page": "https://oncae.gob.hn/biblioteca/manuales/pacc/conceptos-basicos-pacc-oncae-2023/",
    "official_pdf": "https://oncae.gob.hn/wp-content/uploads/2024/05/Conceptos-basicos-PACC-ONCAE-2023.pdf",
    "visible_page_title": "Conceptos básicos PACC – ONCAE 2023",
    "pdf_contents_accessed_before_freeze": false
  },
  "ocr_candidates": [
    {"name": "balanced_200_psm6", "dpi": 200, "psm": 6},
    {"name": "sparse_300_psm11", "dpi": 300, "psm": 11},
    {"name": "auto_300_psm3", "dpi": 300, "psm": 3}
  ],
  "selection_rule": {
    "eligibility": "candidate must pass all frozen PACC, identity, year, quality, cardinality, quarantine and zero-cost gates",
    "score_formula": "mean_confidence + 20*native_token_recall + word_count/(1+word_count)",
    "bounded_word_count_term": "word_count/(1+word_count)",
    "bounded_word_count_range": "[0,1)",
    "tie_break": "lexicographically smallest candidate name",
    "higher_score_is_better": true
  },
  "extract_gate": {
    "pages": 3,
    "languages": "spa+eng",
    "minimum_mean_confidence": 55.0,
    "minimum_native_token_recall": 0.50,
    "minimum_semantic_token": "PACC",
    "identity": {
      "trusted_source_host": "oncae.gob.hn",
      "title_group_minimum": 2,
      "title_group_tokens": ["CONCEPTOS", "BASICOS", "PACC"],
      "year_token": "2023"
    },
    "candidate_archives_hash_summarized": true,
    "empty_pages": 0
  },
  "normalize_gate": {
    "documents": 1,
    "pages": 3,
    "minimum_lines": 1,
    "minimum_words": 1,
    "hashes_and_cardinality_reconciled": true,
    "coordinates_inside_raster": true,
    "byte_identical_replay": true
  },
  "resolve_gate": {
    "required_source_entity": "hn:institution:oncae",
    "source_entity_method": "trusted_source_host_registry",
    "required_text_entity": "hn:concept:pacc",
    "required_year": "2023",
    "forbidden_false_amounts": ["L 2023", "L 2024"],
    "unqualified_numbers_are_not_money": true,
    "abstention_required_when_no_money_resolves": true,
    "byte_identical_replay": true
  },
  "rationale": {
    "v7_failure": "Single 200-DPI PSM-6 OCR read PACC as PACE and failed on color slides.",
    "engineering_evidence": "On the retired V7 document, 300-DPI PSM-11 recovered PACC and correct title text; this result is engineering-only and receives no promotion credit.",
    "improvement": "Run complementary layout strategies, preserve candidate summaries, and separate publisher provenance from OCR text mentions.",
    "same_document_reused": false,
    "pre_execution_amendment": "The phrase bounded word_count lacked an exact function. Before downloading or reading the fresh PDF, it was frozen as word_count/(1+word_count), which is deterministic, parameter-free and contributes less than one score point."
  },
  "execution": {
    "candidate_frozen_before_pdf_download": true,
    "score_formula_frozen_before_pdf_download": true,
    "post_result_retuning_permitted": false,
    "external_cost_usd": 0.0,
    "gcloud_used": false,
    "paid_compute_used": false,
    "merge_authorized": false,
    "mass_processing_authorized": false,
    "novelty_points": 0
  }
}
