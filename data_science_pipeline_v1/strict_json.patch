+def _reject_nonfinite_json_constant(token: str) -> None:
+    raise ValueError(f"non-finite JSON number is forbidden: {token}")
+
+
+def _assert_finite_json_numbers(value: Any) -> None:
+    if isinstance(value, float) and not math.isfinite(value):
+        raise ValueError(f"non-finite JSON number is forbidden: {value!r}")
+    if isinstance(value, list):
+        for item in value:
+            _assert_finite_json_numbers(item)
+    elif isinstance(value, dict):
+        for item in value.values():
+            _assert_finite_json_numbers(item)
+
+
+def strict_json_loads(value: str) -> Any:
+    """Parse standards-compliant JSON and reject all non-finite numbers."""
+    parsed = json.loads(value, parse_constant=_reject_nonfinite_json_constant)
+    _assert_finite_json_numbers(parsed)
+    return parsed
+
+
+def strict_json_dumps(
+    value: Any,
+    *,
+    indent: int | None = None,
+    ensure_ascii: bool = True,
+) -> str:
+    """Serialize standards-compliant JSON deterministically and reject non-finite floats."""
+    return json.dumps(
+        value,
+        indent=indent,
+        sort_keys=True,
+        separators=(",", ":") if indent is None else None,
+        ensure_ascii=ensure_ascii,
+        allow_nan=False,
+    )
+
+
